# UploadThing — https://uploadthing.com/dashboard
# Create an app, copy the API token. Used for originals, thumbnails, masks, derivatives, exports.
UPLOADTHING_TOKEN=

# Hugging Face Inference Providers — https://huggingface.co/settings/tokens
# Fine-grained token with Inference Providers permission.
# Used only on the server. Never expose to the client.
HF_TOKEN=

# Optional: pin a model / provider for instruct-edit. Leave blank to use the app default.
# Example model: black-forest-labs/FLUX.1-Kontext-dev  provider: fal-ai
HF_EDIT_MODEL=
HF_EDIT_PROVIDER=

# Optional: tldraw license key. Without it, the watermark appears (fine for the hackathon).
# https://tldraw.dev
TLDRAW_LICENSE_KEY=

# Public app URL used in signed-URL callbacks and README testing notes.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "1" to allow the labeled demo fallback when no HF_TOKEN is present.
NEXT_PUBLIC_ALLOW_DEMO_FALLBACK=1
